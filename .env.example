# Neon Postgres — pooled for app traffic, direct (unpooled) for migrations
# Gunakan sslmode=verify-full (atau uselibpqcompat=true&sslmode=require) untuk pg/node-postgres
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Auth.js
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Seed admin (dipakai prisma db seed; ganti password setelah login pertama)
ADMIN_EMAIL="perbekasian@gmail.com"
ADMIN_PASSWORD=""
ADMIN_NAME=""

# AES-256-GCM key (32 byte base64) untuk enkripsi token TikTok
TOKEN_ENCRYPTION_KEY=""

# Vercel Cron
CRON_SECRET=""

# TikTok Login Kit / Display API v2 (isi dari developers.tiktok.com)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"

# Kontak tujuan brief (default; bisa diubah di /admin/rate-card)
NEXT_PUBLIC_BUSINESS_WA=""
NEXT_PUBLIC_BUSINESS_EMAIL="perbekasian@gmail.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
